# Optional catalog refresh adapter. Do not copy a real key into this repository.
CAPABILITY_CATALOG_URL=
CAPABILITY_CATALOG_API_KEY=

# Optional live executor. Mock is the safe default.
CAPABILITY_EXECUTOR=mock
CAPABILITY_ENABLE_LIVE_EXECUTION=false
CAPABILITY_REMOTE_EXECUTE_URL=
CAPABILITY_REMOTE_API_KEY=

# Optional. If absent, a random process-local secret is generated.
CAPABILITY_GRANT_SECRET=

# Local server and pinned runtime paths. Blank values use the shown defaults.
CAPABILITY_ADDRESS=127.0.0.1:8092
CAPABILITY_ROOT=
CAPABILITY_CATALOG_PATH=
CAPABILITY_INDEX_PATH=
CAPABILITY_EMBEDDING_SCRIPT=
CAPABILITY_MODEL_CACHE=
CAPABILITY_PYTHON=python
CAPABILITY_POLICY_PATH=
CAPABILITY_DECISION_LOG=

# Version B: front LatentGraph's MCP server instead of the retained catalog.
# Defaults then become 127.0.0.1:8093, policy.latentgraph.json and
# receipts/decision-log.latentgraph.jsonl. The secret file holds LGRAPH_API_KEY,
# LGRAPH_PROJECT_ID, and optionally LGRAPH_PROJECT_NAME and LGRAPH_BRANCH.
CAPABILITY_UPSTREAM=
CAPABILITY_UPSTREAM_SECRET=%LOCALAPPDATA%\capability-envelope\lgraph.env
CAPABILITY_UPSTREAM_WORKDIR=%LOCALAPPDATA%\capability-envelope\latentgraph-work
CAPABILITY_NODE=node
